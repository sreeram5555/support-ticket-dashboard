# Backend server port
PORT=3001

# Turso / LibSQL Database connection
# For local file, use: file:tickets.db
# For remote Turso database, use: libsql://your-db-url.turso.io
DATABASE_URL=file:tickets.db

# Turso Auth Token (Required if DATABASE_URL is a remote libsql:// or https:// URL)
DATABASE_AUTH_TOKEN=

# Environment: development | test | production
NODE_ENV=development
